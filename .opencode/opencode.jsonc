{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "android-skills": {
      "type": "local",
      "command": ["npx", "-y", "android-skills-mcp"],
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  }
}
