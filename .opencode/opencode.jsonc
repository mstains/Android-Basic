{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "android-skills": {
      "type": "local",
      "command": ["npx", "-y", "android-skills-mcp"],
      "enabled": true
    }
  },
  "agent": {
    "android-dev": {
      "description": "Android 开发主力 agent。处理 Kotlin/Java/Compose/Gradle 任务时，Android SDK skill 通过 MCP 获取，本地编码规范与 Git 流程 skill 按场景主动加载，创意任务走 brainstorming 前置澄清。所有非琐碎需求必须先输出「执行方案」并经用户确认后再改动代码（双阶段交付：方案 → 确认 → 执行）。",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.2,
      "color": "#3DDC84",
      "permission": {
        "skill": {
          "android-*": "allow",
          "brainstorming": "allow",
          "android-intent-security": "allow"
        }
      }
    }
  }
}
